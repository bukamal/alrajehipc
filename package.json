{
  "name": "alrajhi-accounting",
  "version": "1.0.0",
  "description": "نظام الراجحي للمحاسبة - إدارة المخزون والفواتير والتقارير المالية",
  "author": "الراجحي <info@alrajhi.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "check": "node check-install.js",
    "postinstall": "node scripts/setup-wasm.js"
  },
  "build": {
    "appId": "com.alrajhi.accounting",
    "productName": "الراجحي للمحاسبة",
    "copyright": "© 2025 الراجحي",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": [ "**/*", "!node_modules/.cache", "!**/*.map", "!.git", "!.vscode", "!dist", "!scripts" ],
    "asarUnpack": [ "lib/sql-wasm.wasm", "lib/**/*" ],
    "extraResources": [ { "from": "node_modules/sql.js/dist/sql-wasm.wasm", "to": "lib/sql-wasm.wasm" } ],
    "win": {
      "target": [ { "target": "nsis", "arch": ["x64", "ia32"] }, { "target": "portable", "arch": ["x64"] } ],
      "icon": "assets/icon.ico",
      "publisherName": "الراجحي"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الراجحي للمحاسبة"
    }
  },
  "dependencies": {
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  }
}
