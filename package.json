{
  "name": "alrajhi-accounting",
  "version": "2.0.0",
  "description": "نظام الراجحي للمحاسبة - SQLite + IndexedDB",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/setup-wasm.js && node scripts/download-libs.js",
    "build-win": "electron-builder --win",
    "check": "node check-install.js"
  },
  "author": "الراجحي",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "sql.js": "^1.10.3"
  },
  "build": {
    "appId": "com.alrajhi.accounting",
    "productName": "الراجحي للمحاسبة",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist"
    ]
  }
}
